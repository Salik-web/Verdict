# ── infra/docker-compose environment ──────────────────────────────────
# Copy to infra/.env (gitignored). These configure the local Postgres and
# Redis containers. Keep credentials in sync with the DATABASE_URL / REDIS_URL
# in apps/api/.env and services/pipeline/.env.

POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geo
POSTGRES_PORT=5432

REDIS_PORT=6379
