# ── services/pipeline environment ─────────────────────────────────────
# Copy to services/pipeline/.env (gitignored) and fill in. Every var the
# service reads is listed here.

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Shared Postgres — must match apps/api and infra/.env.
DATABASE_URL=postgresql+psycopg://geo:geo@localhost:5432/geo

# Redis: Celery broker + result backend.
REDIS_URL=redis://localhost:6379/0

# Internal service-to-service auth. Must be IDENTICAL to apps/api's value.
# Generate a real one with:  openssl rand -hex 32
INTERNAL_SHARED_SECRET=dev-only-change-me-0123456789abcdef

# Mock-first: the whole pipeline runs with NO API keys when true (Phase 2).
# Flip to false only once real keys below are set.
MOCK_MODE=true

# ── Model provider API keys — leave BLANK for now ─────────────────────
# The pipeline runs fully in mock mode without these. Real keys are a
# one-line switch (MOCK_MODE=false) added in a later phase.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
