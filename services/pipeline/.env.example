# ── services/pipeline environment ─────────────────────────────────────
# Copy to services/pipeline/.env (gitignored) and fill in. Every var the
# service reads is listed here.

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Shared Postgres — must match apps/api and infra/.env.
DATABASE_URL=postgresql+psycopg://geo:geo@localhost:5432/geo

# Redis: Celery broker + result backend.
REDIS_URL=redis://localhost:6379/0

# Internal service-to-service auth. Must be IDENTICAL to apps/api's value.
# Generate a real one with:  openssl rand -hex 32
INTERNAL_SHARED_SECRET=dev-only-change-me-0123456789abcdef

# Gateway mode: mock | dev | prod. Default `mock` runs the whole pipeline with
# NO API keys (canned fixtures). dev = free providers, prod = paid models.
# Switching modes is just this var — no code change. (task→model is in
# config/models.yaml.)
GATEWAY_MODE=mock

# ── Deployment mode: WHERE API keys come from ─────────────────────────
# Orthogonal to GATEWAY_MODE, which picks WHICH model answers.
#   self_hosted (default) — one set of keys, yours, from this file or the
#                           environment. This is BYOK and what you want when
#                           running GEO for your own site.
#   managed               — keys belong to a tenant and are fetched per account
#                           by a resolver the hosting application installs at
#                           start-up (see app/gateway/credentials.py). Only
#                           useful if you are building a multi-tenant product
#                           on top; leaving it unset costs you nothing.
DEPLOYMENT_MODE=self_hosted

# ── Model provider API keys — leave BLANK for now ─────────────────────
# Read only by non-mock modes. Each provider's key var is named in
# config/models.yaml (api_key_env). Real keys are a one-line switch later.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Error tracking (optional). Blank -> Sentry stays off. Set in prod only.
SENTRY_DSN=
