# Base URL of the TS API (apps/api). The browser calls this directly with
# credentials, so the API's FRONTEND_ORIGIN must equal THIS app's origin
# (http://localhost:5173 by default) for CORS + cookies to work.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Server-side only (used by the /costs proxy route, screen 8). The cost endpoint
# lives on the Python pipeline and is shared-secret guarded, so the browser can't
# call it — a Next route handler calls it server-side with this secret.
PIPELINE_INTERNAL_URL=http://localhost:8000
INTERNAL_SHARED_SECRET=change-me-to-match-the-pipeline
