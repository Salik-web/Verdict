# ── apps/api environment ──────────────────────────────────────────────
# Copy to apps/api/.env (gitignored) and fill in. Every var the service
# reads is listed here.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Shared Postgres — must match the pipeline service and infra/.env.
DATABASE_URL=postgres://geo:geo@localhost:5432/geo

# Redis (BullMQ jobs on the TS side).
REDIS_URL=redis://localhost:6379/0

# Internal service-to-service auth. Must be IDENTICAL to the pipeline's value.
# Generate a real one with:  openssl rand -hex 32
INTERNAL_SHARED_SECRET=dev-only-change-me-0123456789abcdef

# Base URL of the Python pipeline FastAPI service.
PIPELINE_URL=http://localhost:8000
