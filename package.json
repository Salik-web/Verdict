{
  "name": "geo-saas",
  "version": "0.1.0",
  "private": true,
  "description": "GEO (Generative Engine Optimization) SaaS \u2014 monorepo root",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
