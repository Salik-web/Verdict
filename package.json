      "find-my-way": "^9.7.0",
      "fast-uri": "^3.1.4",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "js-yaml@4": "^4.3.0",
      "brace-expansion": "^5.0.8"
    }
  }
